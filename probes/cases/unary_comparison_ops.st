fn neg_(a: int32) -> int32 { -a }
fn not_(a: bool) -> bool { !a }
fn lt(a: int32, b: int32) -> bool { a < b }
fn le(a: int32, b: int32) -> bool { a <= b }
fn gt(a: int32, b: int32) -> bool { a > b }
fn ge(a: int32, b: int32) -> bool { a >= b }
fn ne(a: int32, b: int32) -> bool { a != b }
